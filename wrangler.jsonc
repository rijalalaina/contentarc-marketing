{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ContentArc marketing site (contentarc.to) on Cloudflare Pages: static export in ./out + Pages Functions in ./functions.
  "name": "contentarc-marketing",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-09-01",
  "vars": {
    "CONTACT_TO_EMAIL": "contact@contentarc.to",
    "BREVO_SENDER_EMAIL": "noreply@contentarc.to",
    "BREVO_LIST_ID": ""
  }
  // Secrets (Pages → Settings → Variables and secrets, or `npx wrangler pages secret put NAME`):
  //   BREVO_API_KEY, TURNSTILE_SECRET_KEY (optional)
}
